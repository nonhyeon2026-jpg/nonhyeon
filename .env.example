# ── 네이버 지도 (배경지도) ────────────────────────────────────────────────
# 네이버 클라우드 플랫폼 → Services → Maps → Application 등록 → "Web Dynamic Map" 이용신청
#   Console: https://console.ncloud.com/naver-service/application
#   Web 서비스 URL 에 http://localhost:3000 을 반드시 등록해야 지도가 뜹니다.
# 값을 비워두면 앱은 자동으로 Leaflet(OSM) 지도로 동작합니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# maps.js 인증 파라미터 이름.
#   2024년 이후 신규 발급(Maps 신규 콘솔): ncpKeyId   ← 기본값
#   그 이전에 발급한 Client ID          : ncpClientId
NEXT_PUBLIC_NAVER_KEY_PARAM=ncpKeyId

# ── VWorld (실제 지적도 필지 폴리곤) ──────────────────────────────────────
# https://www.vworld.kr → 오픈API → 인증키 발급신청 ("데이터 API", 서비스 URL: http://localhost)
# npm run import:vworld 실행 시에만 쓰입니다 (브라우저로 노출되지 않음).
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost
